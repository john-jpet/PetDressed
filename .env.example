NEXT_PUBLIC_API_URL=http://localhost:58000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me

# Backend
# These host URLs are useful for tools run outside Docker. Compose overrides
# container-to-container URLs with Docker service names.
DATABASE_URL=postgresql+psycopg://petdressed:petdressed@localhost:55432/petdressed
REDIS_URL=redis://localhost:56379/0
S3_ENDPOINT_URL=http://localhost:59000
S3_PUBLIC_ENDPOINT_URL=http://localhost:59000
S3_ACCESS_KEY=petdressed
S3_SECRET_KEY=petdressed-local-only
S3_BUCKET=petdressed
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
SEGMENTATION_BACKEND=sam2_transformers
SEGMENTATION_CHECKPOINT=
SEGMENTATION_MODEL_CONFIG=facebook/sam2.1-hiera-tiny
INFERENCE_MAX_DIMENSION=1200
METADATA_BACKEND=fashion_clip
EMBEDDING_MODEL_NAME=patrickjohncyh/fashion-clip
INFERENCE_DEVICE=cpu
MODEL_CACHE_DIR=/models/huggingface
